import asyncio
import logging
from functools import wraps
from aiogram import Router, F, types
from aiogram.filters import Command
from aiogram.fsm.context import FSMContext
from aiogram.fsm.state import State, StatesGroup
from aiogram.types import (
    Message,
    InlineKeyboardMarkup,
    InlineKeyboardButton,
    CallbackQuery,
)
from aiogram.utils.chat_action import ChatActionSender
from aiogram.utils.keyboard import InlineKeyboardBuilder
from config import db

logger = logging.getLogger(__name__)

router = Router()


class Category(StatesGroup):
    name = State()  # category name
    type = State()  # type income|outcome
    finish = State()


# Вывод списка категорий с кнопкой "Добавить"
@router.message(Command("categories"))
@router.callback_query(F.data == "back_to_list")
# @dialog_decorator(single=False)
async def categories_menu(event: Message | CallbackQuery, state: FSMContext):

    if isinstance(event, Message):
        chat_id = event.chat.id
        message_id = event.message_id
        is_message = True
    else:  # CallbackQuery
        chat_id = event.message.chat.id
        message_id = event.message.message_id
        is_message = False

    async with ChatActionSender.typing(bot=event.bot, chat_id=chat_id):
        # Тут загрузка списка из БД
        categories_list = await db.get_categories_list()

    message_content = "<b>📂 Категории</b>\n"
    
    if categories_list:
        for id, name, type, emoji in categories_list:
            text_type = "💰 Доход" if type == "income" else "🛒 Расход"
            message_content += f"🔸 {name} [{text_type}]\n"

    # Клавиатура - пока только с кнопкой "Добавить"
    keyboard = [
        [InlineKeyboardButton(text="➕ Добавить", callback_data="add_category")]
    ]
    reply_markup = InlineKeyboardMarkup(inline_keyboard=keyboard)

    # Обработка в зависимости от типа события
    if is_message:
        # Удаляем сообщение с командой (только для Message)
        await event.delete()
        # Отправляем новое сообщение
        await event.answer(
            text=message_content,
            reply_markup=reply_markup,
        )
    else:  # CallbackQuery
        # Редактируем существующее сообщение
        await event.message.edit_text(
            text=message_content,
            reply_markup=reply_markup,
        )
        # Отвечаем на callback, чтобы убрать часики
        await event.answer()
    await state.set_state(Category.type)


# Обработчик кнопки добавления категории
@router.callback_query(F.data == "add_category")
@router.callback_query(Category.type)
async def handle_add_category(callback: CallbackQuery, state: FSMContext):
    keyboard = [
        [InlineKeyboardButton(text="💰 Доход", callback_data="category_income")],
        [InlineKeyboardButton(text="🛒 Расход", callback_data="category_expense")],
    ]

    reply_markup = InlineKeyboardMarkup(inline_keyboard=keyboard)

    await callback.message.edit_text(
        "<b>Новая категория</b>\nВыберите тип:", reply_markup=reply_markup
    )
    # Запоминаем ID сообщения
    await state.update_data(initial_message_id=callback.message.message_id)

    await state.set_state(Category.name)


@router.callback_query(F.data.startswith("category"), Category.name)
async def capture_category_type(callback: CallbackQuery, state: FSMContext):
    category_type = callback.data.split("_")[1]
    keyboard = [
        [InlineKeyboardButton(text="↩️ Назад", callback_data="add_category")],
    ]
    reply_markup = InlineKeyboardMarkup(inline_keyboard=keyboard)
    await state.update_data(type=category_type)
    category_type = "💰 Доход" if category_type == "income" else "🛒 Расход"
    await callback.message.edit_text(
        text=f"<b>➕ Новая категория</b>\nТип: {category_type}\nВведите название:",
        reply_markup=reply_markup
    )
    await state.set_state(Category.finish)


@router.message(Category.finish)
async def capture_category_name(message: Message, state: FSMContext):
    await state.update_data(name=message.text)
    data = await state.get_data()
    keyboard = [
        [InlineKeyboardButton(text="↩️ Назад к списку", callback_data="back_to_list")],
    ]
    reply_markup = InlineKeyboardMarkup(inline_keyboard=keyboard)
    # Удаляем ответ пользователя
    await message.delete()
    category_type = "💰 Доход" if data.get("type") == "income" else "🛒 Расход"
    await message.answer(
        text=f"<b>✅ Категория добавлена!</b>\nТип: {category_type}\nНазвание: {data.get('name')}\nДобавлена успешно",
        reply_markup=reply_markup
    )
    await state.clear()
